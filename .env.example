# Your configured Torrentio (or any Stremio stream addon) URL, including your debrid config.
# In Stremio: Addons -> Torrentio -> Share/Copy link, or configure one at https://torrentio.strem.fun/configure
# Looks like: https://torrentio.strem.fun/sort=qualitysize|limit=1|...|torbox=YOUR_KEY/manifest.json
# This contains your debrid API key: keep .env private.
STREAM_ADDON_URL=

# Chromecasts as "Name=IP" pairs, comma separated. Name is what you pass as ?device= (fuzzy matched).
# Find IPs in your router, or: curl http://<ip>:8008/setup/eureka_info?params=name
CHROMECASTS=Living Room TV=192.168.1.50,Office TV=192.168.1.51
# Used when a request doesn't pass ?device=...
DEFAULT_CHROMECAST=Living Room TV

# Base URL the Chromecast uses to fetch subtitles and remuxed audio from this server.
# Must be reachable from the TV: this machine's LAN IP and PORT. Auto-detected if unset, which works
# on a plain Linux host (or Docker with network_mode: host) but not inside WSL or Docker bridge networking.
PUBLIC_URL=http://192.168.1.10:8766

HOST=0.0.0.0
PORT=8766

# Follow the addon's /resolve redirect and cast the direct debrid URL (recommended)
RESOLVE_REDIRECT=true

# Override the MIME type sent to the Chromecast (default: guessed from extension; mkv -> video/x-matroska).
# If MKVs fail to start on your device, try video/mp4.
CAST_CONTENT_TYPE=

# Audio codecs the Chromecast plays as-is; anything else (e.g. eac3/ac3/dts/truehd) is converted to AAC.
# Add ac3,eac3 if your TV or soundbar supports Dolby passthrough.
CAST_AUDIO_CODECS=aac,mp3,opus,vorbis,flac

# Parallel connections for embedded-subtitle extraction (reads the whole file). Keep at 1:
# debrid CDNs are connection/rate limited and may refuse your IP if you go higher.
SUB_CONNECTIONS=1

# Subtitle addon (Stremio addon protocol)
OPENSUBTITLES_ADDON_URL=https://opensubtitles-v3.strem.io
